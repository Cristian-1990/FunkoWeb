@page
@model IndexModel
@{
    ViewData["Title"] = "Catálogo";

    decimal ConIva(decimal precio) => Math.Round(precio * 1.21m, 2);
}

<h1 class="mb-4">Catálogo de Funkos</h1>

<form method="get" class="d-flex mb-4">
    <input type="search" name="busqueda" value="@Model.Busqueda" class="form-control me-2" placeholder="Buscar por nombre" />
    <button type="submit" class="btn btn-outline-primary">Buscar</button>
</form>

@if (Model.Funkos.Count == 0)
{
    if (string.IsNullOrWhiteSpace(Model.Busqueda))
    {
        <p>No hay Funkos en el catálogo.</p>
    }
    else
    {
        <p>No hay Funkos que coincidan con «@Model.Busqueda».</p>
    }
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-3">
        @foreach (var funko in Model.Funkos)
        {
            <div class="col">
                <div class="card h-100">
                    <img src="@funko.Imagen" class="card-img-top" alt="Foto de @funko.Nombre" />
                    <div class="card-body">
                        <h5 class="card-title">@funko.Nombre</h5>
                        <p class="card-text text-muted">@funko.CategoriaNombre · @funko.Anio</p>
                        <p class="card-text">@ConIva(funko.PrecioReferencia).ToString("C") (IVA incl.)</p>
                    </div>
                </div>
            </div>
        }
    </div>
}