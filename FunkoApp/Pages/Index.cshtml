@page
@model IndexModel
@{
    ViewData["Title"] = "Catálogo";
}

@* TempData["Exito"] lo deja la página Crear tras el POST; se lee una sola vez. *@
@if (TempData["Exito"] is string exito)
{
    <div class="alert alert-success" role="alert">@exito</div>
}

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Catálogo de Funkos</h1>
    <a class="btn btn-primary" asp-page="/Crear">Nuevo Funko</a>
</div>

<form method="get" class="d-flex mb-4">
    <input type="search" name="busqueda" value="@Model.Busqueda" class="form-control me-2" placeholder="Buscar por nombre" />
    <button type="submit" class="btn btn-outline-primary">Buscar</button>
</form>

@if (Model.Funkos.Count == 0)
{
    if (string.IsNullOrWhiteSpace(Model.Busqueda))
    {
        <p>No hay Funkos en el catálogo.</p>
    }
    else
    {
        <p>No hay Funkos que coincidan con «@Model.Busqueda».</p>
    }
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-3">
        @foreach (var funko in Model.Funkos)
        {
            <div class="col">
                <partial name="_TarjetaFunko" model="funko" />
            </div>
        }
    </div>
}